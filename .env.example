# Required: Your Anthropic API key for AI-powered outreach
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Apollo.io API key for lead enrichment
APOLLO_API_KEY=your-apollo-api-key

# Optional: Resend API for sending outreach emails
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=Your Name <you@yourdomain.com>

# Optional: SMTP settings (legacy, Resend is preferred)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: Calendar link for meeting booking
CALENDAR_LINK=https://calendly.com/your-link

# Optional: Your company info (used to personalize outreach)
COMPANY_NAME=Your Company
COMPANY_DESCRIPTION=We help companies do X
SENDER_NAME=Your Name
SENDER_TITLE=Sales Development Representative
